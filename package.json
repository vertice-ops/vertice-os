{
  "name": "vertice-os-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npx serve . -l tcp://3000",
    "watch": "chokidar '**/*' -i '.git/**' -i 'node_modules/**' -i 'dist/**' -d 2000 -c './auto-push.sh'",
    "start": "concurrently \"npm run dev\" \"npm run watch\""
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
